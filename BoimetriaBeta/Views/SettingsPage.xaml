<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BoimetriaBeta.ViewModels"
             x:Class="BoimetriaBeta.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Ajustes"
             BackgroundColor="{StaticResource BackgroundPrimary}">

    <Shell.TitleView>
        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
            <Label Text="Ajustes"
                   FontFamily="OpenSansSemibold"
                   FontAttributes="Bold"
                   FontSize="17"
                   TextColor="{StaticResource TextPrimary}"
                   VerticalOptions="Center" />
            <Border Style="{StaticResource BetaChip}" VerticalOptions="Center">
                <Label Text="BETA"
                       FontFamily="OpenSansSemibold"
                       FontSize="9"
                       FontAttributes="Bold"
                       CharacterSpacing="1"
                       TextColor="White" />
            </Border>
        </HorizontalStackLayout>
    </Shell.TitleView>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,8,20,32" Spacing="22">

                <VerticalStackLayout Spacing="4">
                    <Label Text="PREPARAR O APP"
                           Style="{StaticResource SectionLabel}"
                           TextColor="{StaticResource Accent}" />
                    <Label Text="Arquivo do sistema"
                           FontFamily="OpenSansSemibold"
                           FontAttributes="Bold"
                           FontSize="22"
                           CharacterSpacing="-0.5"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="O técnico te manda um arquivo. Você carrega aqui e o app fica pronto pra reconhecer os boi."
                           Style="{StaticResource SubtitleLabel}" />
                </VerticalStackLayout>

                <!-- Status card -->
                <Border Style="{StaticResource Card}">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource AccentSoft}"
                                    StrokeShape="RoundRectangle 14"
                                    WidthRequest="48"
                                    HeightRequest="48">
                                <Label Text="📦"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding ModelFileName}"
                                       FontFamily="OpenSansSemibold"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="{StaticResource TextPrimary}"
                                        />
                                <Label Text="{Binding ModelStatus}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2"
                                    StrokeShape="RoundRectangle 999"
                                    VerticalOptions="Center"
                                    Padding="10,20"
                                    Background="{Binding StatusChipBrush}">
                                <Label Text="{Binding StatusChipText}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="10"
                                       VerticalTextAlignment="Center"
                                       CharacterSpacing="2"
                                       FontAttributes="Bold"    
                                       TextColor="White" />
                            </Border>
                        </Grid>

                        <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource Divider}" />

                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Text="Carregar arquivo"
                                    Command="{Binding PickModelCommand}" />
                            <Button Grid.Column="1"
                                    Text="Tirar"
                                    Style="{StaticResource OutlineButton}"
                                    IsEnabled="{Binding HasModel}"
                                    Command="{Binding ClearModelCommand}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Dica -->
                <Border Style="{StaticResource MutedCard}" Padding="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="💡" FontSize="22" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Se o app não estiver reconhecendo direito, peça uma atualização do arquivo pro responsável técnico."
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Preferences -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="PREFERÊNCIAS" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource BorderedCard}" Padding="0">
                        <VerticalStackLayout Spacing="0">

                            <Grid Padding="14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Style="{StaticResource IconBadge}">
                                    <Label Text="🔔" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Avisos no celular"
                                           FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="13" />
                                    <Label Text="Receber aviso quando achar boi novo"
                                           FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Style="{StaticResource ComingSoonChip}" VerticalOptions="Center">
                                    <Label Text="EM BREVE"
                                           FontFamily="OpenSansSemibold" FontSize="9" FontAttributes="Bold"
                                           CharacterSpacing="2" TextColor="{StaticResource TextSecondary}" />
                                </Border>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Divider}" Margin="14,0" />

                            <Grid Padding="14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Style="{StaticResource IconBadge}">
                                    <Label Text="☁️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Salvar na nuvem"
                                           FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="13" />
                                    <Label Text="Backup das fotos e do histórico"
                                           FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Style="{StaticResource ComingSoonChip}" VerticalOptions="Center">
                                    <Label Text="EM BREVE"
                                           FontFamily="OpenSansSemibold" FontSize="9" FontAttributes="Bold"
                                           CharacterSpacing="2" TextColor="{StaticResource TextSecondary}" />
                                </Border>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Divider}" Margin="14,0" />

                            <Grid Padding="14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Style="{StaticResource IconBadge}">
                                    <Label Text="🔤" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Letras maiores"
                                           FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="13" />
                                    <Label Text="Aumenta o tamanho do texto pra leitura no sol"
                                           FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Style="{StaticResource ComingSoonChip}" VerticalOptions="Center">
                                    <Label Text="EM BREVE"
                                           FontFamily="OpenSansSemibold" FontSize="9" FontAttributes="Bold"
                                           CharacterSpacing="2" TextColor="{StaticResource TextSecondary}" />
                                </Border>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Sobre -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="SOBRE" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource BorderedCard}" Padding="0">
                        <VerticalStackLayout Spacing="0">
                            <Grid Padding="14" ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Versão do app" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="1.0 (beta)" FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Divider}" Margin="14,0" />
                            <Grid Padding="14" ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Pra que serve" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Identificar boi pelo focinho" FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Divider}" Margin="14,0" />
                            <Grid Padding="14" ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Onde funciona" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Direto no celular, sem internet" FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Label Text="Boimetria · feito pra fazenda"
                       FontFamily="OpenSansSemibold"
                       FontSize="10"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource TextSecondary}"
                       Margin="0,12,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Busy overlay -->
        <Border IsVisible="{Binding IsBusy}"
                BackgroundColor="#CCFFFFFF"
                StrokeShape="Rectangle"
                Stroke="Transparent">
            <Border Style="{StaticResource Card}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="28"
                    WidthRequest="240">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True"
                                       Color="{StaticResource Accent}"
                                       WidthRequest="42"
                                       HeightRequest="42" />
                    <Label Text="{Binding BusyMessage}"
                           FontFamily="OpenSansSemibold"
                           FontAttributes="Bold"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource TextPrimary}" />
                </VerticalStackLayout>
            </Border>
        </Border>

    </Grid>

</ContentPage>
